# Backend Server Configuration
PORT=3000

# MongoDB Connection String
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ride_and_serve?retryWrites=true&w=majority

# JWT Secret Key for token generation
